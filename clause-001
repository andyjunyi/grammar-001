let currentQ = 0;
let score = 0;
let userAnswers = [];
let answered = [];

function buildQuiz() {
  const main = document.getElementById('quizArea');
  main.innerHTML = '';
  questions.forEach((q, i) => {
    const card = document.createElement('div');
    card.className = 'question-card' + (i === 0 ? ' active' : '');
    card.id = `card-${i}`;

    const letters = ['A','B','C','D'];
    const optHtml = q.options.map((opt, j) => `
      <button class="option-btn" id="opt-${i}-${j}" onclick="selectAnswer(${i}, ${j})" data-q="${i}" data-opt="${j}">
        <span class="option-letter">${letters[j]}</span>
        <span>${opt}</span>
      </button>
    `).join('');

    const vocabHtml = q.vocab.map(v => `
      <div class="vocab-chip"><strong>${v.word}</strong>${v.def}</div>
    `).join('');

    card.innerHTML = `
      <div class="card-header">
        <div class="q-number">${String(i+1).padStart(2,'0')}</div>
        <div class="q-tag">${q.tag}</div>
      </div>
      <div class="card-body">
        <div class="question-text">${formatQuestion(q.q)}</div>
        <div class="options-grid">${optHtml}</div>
        <div class="result-panel" id="result-${i}">
          <div class="verdict" id="verdict-${i}"></div>
          <div class="section-label">中文翻譯</div>
          <div class="translation-box">${q.translation}</div>
          <div class="section-label">必備單字</div>
          <div class="vocab-list">${vocabHtml}</div>
          <div class="section-label">詳細解析</div>
          <div class="analysis-box">${q.analysis}</div>
        </div>
        <button class="next-btn" id="next-${i}" onclick="nextQuestion(${i})">
          ${i < questions.length - 1 ? '下一題' : '查看結果'}
        </button>
      </div>
    `;
    main.appendChild(card);
  });
}

function formatQuestion(text) {
  return text.replace(/______/g, '<span class="blank" id="blankFill">______</span>');
}

function selectAnswer(qi, optIdx) {
  if (answered[qi]) return;
  answered[qi] = true;
  userAnswers[qi] = optIdx;

  const correct = questions[qi].answer;
  const letters = ['A','B','C','D'];

  for (let j = 0; j < 4; j++) {
    const btn = document.getElementById(`opt-${qi}-${j}`);
    btn.disabled = true;
    if (j === correct) btn.classList.add('correct');
    else if (j === optIdx && optIdx !== correct) btn.classList.add('wrong');
  }

  // Fill blank
  const card = document.getElementById(`card-${qi}`);
  const blank = card.querySelector('.blank');
  if (blank) {
    blank.textContent = questions[qi].options[correct];
    blank.style.borderColor = optIdx === correct ? 'var(--green)' : 'var(--red)';
    blank.style.color = optIdx === correct ? 'var(--green)' : 'var(--red)';
  }

  if (optIdx === correct) score++;

  const verdict = document.getElementById(`verdict-${qi}`);
  if (optIdx === correct) {
    verdict.className = 'verdict correct-v';
    verdict.innerHTML = `<span class='verdict-icon'>✅</span> 答對了！正確答案是 (${letters[correct]}) ${questions[qi].options[correct]}`;
  } else {
    verdict.className = 'verdict wrong-v';
    verdict.innerHTML = `<span class='verdict-icon'>❌</span> 答錯了！正確答案是 (${letters[correct]}) ${questions[qi].options[correct]}`;
  }

  document.getElementById(`result-${qi}`).classList.add('show');
  document.getElementById(`next-${qi}`).classList.add('show');

  updateProgress();
}

function nextQuestion(qi) {
  document.getElementById(`card-${qi}`).classList.remove('active');
  if (qi + 1 < questions.length) {
    document.getElementById(`card-${qi + 1}`).classList.add('active');
    document.getElementById(`card-${qi + 1}`).scrollIntoView({ behavior: 'smooth', block: 'start' });
  } else {
    showResult();
  }
}

function updateProgress() {
  const done = answered.filter(Boolean).length;
  const pct = (done / questions.length) * 100;
  document.getElementById('progressBar').style.width = pct + '%';
  document.getElementById('progressLabel').textContent = `${done} / ${questions.length}`;
  document.getElementById('liveScore').textContent = score;
  document.getElementById('liveDone').textContent = done;
}

function showResult() {
  document.getElementById('quizArea').style.display = 'none';
  const rs = document.getElementById('result-screen');
  rs.classList.add('show');

  const pct = Math.round((score / questions.length) * 100);
  document.getElementById('finalScore').textContent = `${score} / ${questions.length}`;

  const letters = ['A','B','C','D'];
  let msg = '';
  let trophy = '';
  if (pct >= 90) { msg = '太厲害了！你對名詞子句與間接問句掌握得非常好！🎉'; trophy = '🏆'; }
  else if (pct >= 70) { msg = '表現不錯！再複習一下錯誤的題目，你會更進步的！📚'; trophy = '🥈'; }
  else if (pct >= 50) { msg = '還有進步的空間，多複習 that / whether / 間接問句語序吧！💪'; trophy = '🥉'; }
  else { msg = '別灰心！仔細閱讀每題解析，下次一定會更好！✨'; trophy = '📖'; }

  document.getElementById('trophyEmoji').textContent = trophy;
  document.getElementById('finalMsg').textContent = msg;

  const tbody = document.getElementById('resultBody');
  tbody.innerHTML = questions.map((q, i) => {
    const ua = userAnswers[i];
    const isCorrect = ua === q.answer;
    const qShort = q.q.replace(/______/g, '___').substring(0, 40) + '...';
    return `<tr>
      <td style="font-family:'DM Mono',monospace;color:var(--gold)">${i+1}</td>
      <td>${qShort}</td>
      <td style="font-family:'DM Mono',monospace">${ua !== undefined ? '(' + letters[ua] + ') ' + q.options[ua] : '未作答'}</td>
      <td style="font-family:'DM Mono',monospace">(${letters[q.answer]}) ${q.options[q.answer]}</td>
      <td class="${isCorrect ? 'correct-mark' : 'wrong-mark'}">${isCorrect ? '✓' : '✗'}</td>
    </tr>`;
  }).join('');

  rs.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function restartQuiz() {
  score = 0;
  userAnswers = [];
  answered = [];
  document.getElementById('result-screen').classList.remove('show');
  document.getElementById('quizArea').style.display = '';
  buildQuiz();
  updateProgress();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

buildQuiz();
updateProgress();
</script>

